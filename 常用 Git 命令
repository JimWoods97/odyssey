1. 配置
bash
git config --global user.name "你的名字"
git config --global user.email "你的邮箱"
git config --global color.ui auto


2. 建库 / 克隆
bash
git init [项目名]          # 新建本地仓库
git clone [url]            # 克隆远程仓库
git remote add origin [url]# 给本地仓库绑定远程地址


3. 查看状态与改动
bash
git status                 # 当前状态
git diff                   # 工作区 vs 暂存区
git diff --staged          # 暂存区 vs 上次提交
git log                    # 提交历史
git log --oneline --graph  # 精简历史+图形


4. 暂存与提交
bash
git add [文件]             # 添加单个文件
git add .                 # 添加当前目录所有改动
git commit -m "说明"       # 提交
git commit --amend        # 补提交到上一次提交


5. 分支
bash
git branch                # 查看本地分支
git branch [名]           # 新建分支
git checkout [分支]       # 切换分支（老写法）
git switch [分支]         # 切换分支（新写法）
git switch -c [分支]      # 新建并切换
git merge [分支]          # 合并分支
git branch -d [分支]      # 删除已合并分支


6. 撤销 / 回退
bash
git reset [文件]          # 取消暂存，保留改动
git restore [文件]        # 丢弃工作区改动（新写法）
git checkout -- [文件]    # 丢弃工作区改动（老写法）
git reset --soft [commit] # 只回退提交，保留暂存和工作区
git reset --mixed [commit]# 回退提交和暂存，保留工作区
git reset --hard [commit] # 彻底回退，慎用
git revert [commit]       # 用新提交反转某次提交，适合已推送


7. 暂存临时改动
bash
git stash                 # 暂存修改
git stash list            # 查看 stash 列表
git stash pop             # 恢复最近一次 stash 并删除
git stash drop            # 删除最近一次 stash


8. 远程同步
bash
git fetch [remote]        # 拉取远程历史，不合并
git pull                  # fetch + merge
git push [remote] [分支]  # 推送到远程
git push -u origin [分支] # 第一次推送并关联


9. 标签
bash
git tag                   # 查看标签
git tag v1.0              # 打轻量标签
git tag -a v1.0 -m "说明" # 打附注标签
git push origin v1.0      # 推送标签


10. 典型工作流
bash
git clone [url]
cd [仓库]
git switch -c feature/x
# 改代码
git status
git add .
git commit -m "做了什么"
git push -u origin feature/x
# 在 GitHub 开 PR，合并后：
git switch main
git pull
